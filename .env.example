# Configuration Docker Compose (copier en .env : cp .env.example .env)

# Base de données PostgreSQL
POSTGRES_USER=epitrello
POSTGRES_PASSWORD=epitrello
POSTGRES_DB=epitrello

# Secret qui signe les connexions (JWT) — générer avec : openssl rand -hex 32
JWT_SECRET=

# Ports exposés sur la machine
DB_PORT=5433
API_PORT=3000
WEB_PORT=8080
MAILPIT_PORT=8025
