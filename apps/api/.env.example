# Configuration de l'API en mode développement (npm run dev)
# Copier en .env : cp .env.example .env

# Base Docker lancée par : docker compose up -d db mailpit
DATABASE_URL=postgresql://epitrello:epitrello@localhost:5433/epitrello

# Secret qui signe les connexions (JWT) — générer avec : openssl rand -hex 32
JWT_SECRET=

# URL de l'interface (utilisée dans le lien du mail « mot de passe oublié »)
WEB_URL=http://localhost:5180

# Serveur mail de dev (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

PORT=3000
